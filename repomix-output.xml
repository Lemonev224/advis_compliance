        <div className="rounded-t-xl rounded-b-md border-[10px] border-[#0c1e3f] bg-[#0c1e3f] shadow-[0_40px_80px_-24px_rgba(2,10,26,0.6)]">
          {/* browser chrome */}
          <div className="flex items-center gap-1.5 bg-[#0c1e3f] px-3 py-2.5 rounded-t-sm">
