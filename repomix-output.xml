            </motion.button>

            {status === "success" && (
              <p className="mt-4 text-[14px] text-cyan">{t("form.success")}</p>
            )}
            {status === "error" && (
              <p className="mt-4 text-[14px] text-red-400">{errorMsg}</p>
            )}
          </motion.form>
        </div>
      </div>
    </section>
  );
}
