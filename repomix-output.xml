    description:
      "We turn complex regulatory requirements into scalable software infrastructure for regulated industries.",
    url: "https://advisorly.tech",
    siteName: "Advisorly",
    images: [
      {
        url: "/og-image.png",
        width: 1200,
        height: 630,
        alt: "Advisorly — Compliance Infrastructure",
      },
    ],
    locale: "en_US",
    type: "website",
  },
  twitter: {
